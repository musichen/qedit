{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "sortImports": {
    "groups": ["external", ["parent", "sibling", "index"], "style"],
    "newlinesBetween": true,
    "order": "asc",
  },
  // src-tauri/gen is regenerated (minified) by the Tauri CLI on every build,
  // so formatting it would leave the tree dirty after `check:native`.
  "ignorePatterns": [
    "node_modules",
    "dist",
    "*.md",
    "routeTree.gen.ts",
    "**/src-tauri/gen/**",
  ],
}

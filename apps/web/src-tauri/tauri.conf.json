{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui-1.4/main/nicegui/static/tauri-conf-schema.json",
  "productName": "qedit",
  "version": "0.1.0",
  "identifier": "dev.qedit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "title": "qedit",
    "windows": [
      {
        "title": "qedit",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$HOME/**"],
        "deny": []
      }
    },
    "shell": {
      "open": true
    },
    "dialog": {}
  }
}
